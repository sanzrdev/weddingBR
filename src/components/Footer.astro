---
interface Props {
  bride: string;
  groom: string;
  date: string;
}

const { bride, groom, date } = Astro.props;
---

<footer class="bg-stone-800 px-6 py-12 text-center text-stone-100">
  <p class="font-serif text-3xl">
    {bride} <span class="text-2xl">&</span> {groom}
  </p>
  <p class="mt-4 text-[0.65rem] uppercase tracking-[0.28em] text-stone-400">
    {date}
  </p>
  <div class="mx-auto mt-8 h-px w-10 bg-stone-600"></div>
</footer>
