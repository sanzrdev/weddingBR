---
interface Props {
  spotifyEmbedUrl: string;
  spotifyUrl: string;
}

const { spotifyEmbedUrl, spotifyUrl } = Astro.props;
---

<section class="texture-paper px-6 py-24" aria-labelledby="music-title">
  <div class="mx-auto max-w-md text-center">
    <div data-reveal>
      <p class="text-xs uppercase tracking-[0.35em] text-stone-500">
        Dale play
      </p>
      <h2 id="music-title" class="mt-4 text-4xl font-medium">
        Nuestra música
      </h2>
      <p class="mt-5 text-sm leading-6 text-stone-600">
        Una canción que nos acompaña en este capítulo de nuestra historia.
      </p>
    </div>

    <div class="mt-12 overflow-hidden rounded-sm border border-stone-200 bg-white p-3 shadow-[0_16px_35px_rgba(41,39,37,0.08)]" data-reveal style="--reveal-delay: 140ms">
      <iframe
        title="Nuestra canción en Spotify"
        src={spotifyEmbedUrl}
        width="100%"
        height="152"
        frameborder="0"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"
      ></iframe>
    </div>

    <a
      href={spotifyUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-7 inline-flex border-b border-stone-400 pb-1 text-xs font-medium uppercase tracking-[0.18em] text-stone-700 transition-colors hover:border-stone-800 hover:text-stone-950 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-stone-700"
      data-reveal
      style="--reveal-delay: 240ms"
    >
      Abrir en Spotify
    </a>
  </div>
</section>
