---
interface Props {
  title: string;
  coverUrl: string;
  spotifyEmbedUrl: string;
  spotifyUrl: string;
}

const { title, coverUrl, spotifyEmbedUrl, spotifyUrl } = Astro.props;
---

<section class="section-transition texture-paper px-6 py-24" style="--transition-from: #ffffff" aria-labelledby="music-title">
  <div class="mx-auto max-w-md text-center">
    <div data-reveal>
      <p class="text-xs uppercase tracking-[0.35em] text-stone-500">
        Dale play
      </p>
      <h2 id="music-title" class="mt-4 text-4xl font-medium">
        Nuestra música
      </h2>
      <p class="mt-5 text-sm leading-6 text-stone-600">
        Una canción que nos acompaña en este capítulo de nuestra historia.
      </p>
    </div>

    <figure class="mx-auto mt-12 w-full max-w-[19rem] -rotate-1 bg-white p-3 pb-6 shadow-[0_18px_38px_rgba(41,39,37,0.16)] transition-transform duration-500 hover:rotate-0" data-reveal style="--reveal-delay: 140ms">
      <div class="aspect-square overflow-hidden bg-stone-200">
        <img
          src={coverUrl}
          alt={`Portada de ${title}`}
          class="size-full object-cover"
          loading="lazy"
        />
      </div>
      <figcaption class="pt-5 text-center">
        <p class="font-serif text-2xl text-stone-800">{title}</p>
        <p class="mt-1 text-[0.6rem] uppercase tracking-[0.22em] text-stone-500">Nuestra canción</p>
      </figcaption>
    </figure>

    <div class="mt-8 overflow-hidden rounded-sm border border-stone-200 bg-white p-2 shadow-[0_12px_28px_rgba(41,39,37,0.06)]" data-reveal style="--reveal-delay: 220ms">
      <iframe
        title="Nuestra canción en Spotify"
        src={spotifyEmbedUrl}
        width="100%"
        height="152"
        frameborder="0"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"
      ></iframe>
    </div>

    <a
      href={spotifyUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-7 inline-flex border-b border-stone-400 pb-1 text-xs font-medium uppercase tracking-[0.18em] text-stone-700 transition-colors hover:border-stone-800 hover:text-stone-950 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-stone-700"
      data-reveal
      style="--reveal-delay: 240ms"
    >
      Abrir en Spotify
    </a>
  </div>
</section>
