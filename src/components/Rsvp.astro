---
interface Props {
  phone: string;
}

const { phone } = Astro.props;
const initialMessage = "Hola, quiero confirmar mi asistencia a la boda de Belén y Roldan.";
---

<section class="texture-sand px-6 py-24" aria-labelledby="rsvp-title">
  <div class="mx-auto max-w-md">
    <header class="text-center" data-reveal>
      <p class="text-xs uppercase tracking-[0.35em] text-stone-500">
        Acompáñanos
      </p>
      <h2 id="rsvp-title" class="mt-4 text-4xl font-medium">
        Confirma tu asistencia
      </h2>
      <p class="mt-5 text-sm leading-6 text-stone-600">
        Nos encantará celebrar contigo. Completa tus datos y envíanos tu confirmación por WhatsApp.
      </p>
    </header>

    <form class="mt-12 space-y-7" data-rsvp data-phone={phone} data-reveal style="--reveal-delay: 140ms">
      <label class="block">
        <span class="text-xs uppercase tracking-[0.18em] text-stone-600">Tu nombre</span>
        <input
          name="name"
          type="text"
          required
          autocomplete="name"
          class="mt-3 w-full border-b border-stone-300 bg-transparent px-0 py-3 text-base text-stone-800 outline-none transition-colors placeholder:text-stone-400 focus:border-stone-800"
          placeholder="Escribe tu nombre"
        />
      </label>

      <fieldset>
        <legend class="text-xs uppercase tracking-[0.18em] text-stone-600">¿Podrás acompañarnos?</legend>
        <div class="mt-3 grid grid-cols-2 gap-3">
          <label class="cursor-pointer border border-stone-300 px-4 py-3 text-center text-sm text-stone-700 transition-colors has-[:checked]:border-stone-800 has-[:checked]:bg-white">
            <input class="sr-only" type="radio" name="attendance" value="Sí, con gusto asistiré" checked />
            Sí, asistiré
          </label>
          <label class="cursor-pointer border border-stone-300 px-4 py-3 text-center text-sm text-stone-700 transition-colors has-[:checked]:border-stone-800 has-[:checked]:bg-white">
            <input class="sr-only" type="radio" name="attendance" value="No podré asistir" />
            No podré asistir
          </label>
        </div>
      </fieldset>

      <a
        href={`https://wa.me/${phone}?text=${encodeURIComponent(initialMessage)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="flex w-full items-center justify-center gap-2 bg-stone-800 px-6 py-4 text-xs font-medium uppercase tracking-[0.2em] text-white transition-colors hover:bg-stone-700 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-stone-800"
        data-rsvp-submit
      >
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path d="M21 11.5a8.38 8.38 0 0 1-9 8.4 9.5 9.5 0 0 1-4-.9L3 21l1.7-4.6A8.5 8.5 0 1 1 21 11.5Z" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M8.5 9.5c.2 2.6 2.2 4.5 4.7 4.8l1.1-1.1 1.8.9c.3.1.4.5.2.7l-.8.9c-.3.3-.7.4-1.1.3-3.9-.9-6.5-3.4-7.4-7.1-.1-.4 0-.8.3-1.1l.9-.8c.3-.2.6-.1.7.2l.8 1.8Z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Enviar por WhatsApp
      </a>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-rsvp]");

  if (form) {
    const attendanceInputs = form.querySelectorAll<HTMLInputElement>('input[name="attendance"]');
    const submitLink = form.querySelector<HTMLAnchorElement>("[data-rsvp-submit]");

    const updateRsvp = () => {
      const formData = new FormData(form);
      const attending = formData.get("attendance") === "Sí, con gusto asistiré";
      const name = String(formData.get("name") ?? "").trim();

      const message = attending
        ? `Hola, soy ${name || "[tu nombre]"}. Confirmo mi asistencia a la boda de Belén y Roldan.`
        : `Hola, soy ${name || "[tu nombre]"}. Lamentablemente no podré asistir a la boda de Belén y Roldan.`;

      if (submitLink) {
        submitLink.href = `https://wa.me/${form.dataset.phone}?text=${encodeURIComponent(message)}`;
      }
    };

    form.addEventListener("input", updateRsvp);
    attendanceInputs.forEach((input) => input.addEventListener("change", updateRsvp));
    submitLink?.addEventListener("click", (event) => {
      if (!form.reportValidity()) {
        event.preventDefault();
      }
    });
    updateRsvp();
  }
</script>
