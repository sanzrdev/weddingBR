---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import   { wedding } from "../data/wedding.ts";
import EventDetails from "../components/EventDetails.astro";
import OurStory from "../components/OurStory.astro"
import Gallery from "../components/Gallery.astro";
import Countdown from "../components/Countdown.astro";
import Rsvp from "../components/Rsvp.astro";
import OurMusic from "../components/OurMusic.astro";
import GiftEnvelope from "../components/GiftEnvelope.astro";
import ImageFooter from "../components/ImageFooter.astro";
---

<Layout
  title="Nuestra boda | Belén & Roldan"
  description="Acompáñanos a celebrar nuestra boda."
>
  <main>
	<Hero bride={wedding.couple.bride} groom={wedding.couple.groom} date={`${wedding.date.day} · ${wedding.date.month} · ${wedding.date.year}`}  />

	<Countdown target={wedding.date.countdownTarget} />

	<EventDetails events={wedding.events}/>
	<OurStory image={wedding.story.image}/>
	<Gallery images={wedding.gallery}/>

	<OurMusic
      title={wedding.music.title}
      coverUrl={wedding.music.coverUrl}
      spotifyEmbedUrl={wedding.music.spotifyEmbedUrl}
      spotifyUrl={wedding.music.spotifyUrl}
    />

	<Rsvp phone={wedding.rsvp.phone} />

	<GiftEnvelope />

  </main>

  <ImageFooter />
</Layout>
